<script lang="ts">
	import { fade, fly } from 'svelte/transition';
	import { goto } from '$app/navigation';
	import toast from 'svelte-french-toast';
	import Nav from '$lib/components/nav.svelte';
	import NewsFooter from '$lib/components/news-footer.svelte';

	export let data;
	let publications = data.publications || [];

	let searchQuery = '';
	let activeFilter = 'All';

	// Extended filters for Knowledge Hub
	const filters = ['All', 'Research Paper', 'Article', 'Blog', 'News', 'Campaign', 'Event', 'Testimonial', 'FAQ'];

	$: filteredPublications = publications.filter(pub => {
		const matchesSearch = pub.title.toLowerCase().includes(searchQuery.toLowerCase()) || 
							  pub.excerpt.toLowerCase().includes(searchQuery.toLowerCase());
		
		let matchesFilter = true;
		if (activeFilter !== 'All') {
			if (activeFilter === 'Research Paper' && pub.type !== 'research') matchesFilter = false;
			if (activeFilter === 'Article' && pub.type !== 'article') matchesFilter = false;
			if (activeFilter === 'Blog' && pub.type !== 'blog') matchesFilter = false;
			if (activeFilter === 'News' && pub.type !== 'news') matchesFilter = false;
			if (activeFilter === 'Campaign' && pub.type !== 'campaign') matchesFilter = false;
			if (activeFilter === 'Event' && pub.type !== 'event') matchesFilter = false;
			if (activeFilter === 'Testimonial' && pub.type !== 'testimonials') matchesFilter = false;
			if (activeFilter === 'FAQ' && pub.type !== 'faq') matchesFilter = false;
		}

		return matchesSearch && matchesFilter;
	});

	let localLikes: Record<string, boolean> = {};

	function toggleLike(e: Event, pub: any) {
		e.stopPropagation();
		localLikes[pub.id] = !localLikes[pub.id];
		if (localLikes[pub.id]) {
			toast.success('Liked! ❤️');
		}
	}

	function shareArticle(e: Event, pub: any) {
		e.stopPropagation();
		const url = `${window.location.origin}/content/${pub.type}/${pub.slug}`;
		navigator.clipboard.writeText(url).then(() => {
			toast.success('Link copied to clipboard!');
		});
	}

	function openPublication(pub: any) {
		if (pub.slug) {
			goto(`/content/${pub.type}/${pub.slug}`);
		} else {
			toast.error('Publication link is missing.');
		}
	}

	function getBadgeColor(type: string) {
		switch (type) {
			case 'research': return 'badge-research';
			case 'article': return 'badge-article';
			case 'blog': return 'badge-blog';
			case 'news': return 'badge-news';
			case 'campaign': return 'badge-campaign';
			case 'event': return 'badge-event';
			case 'testimonials': return 'badge-testimonial';
			case 'faq': return 'badge-faq';
			default: return 'badge-default';
		}
	}
</script>

<svelte:head>
	<title>Community & Knowledge Hub | Jarurat Care Foundation</title>
	<meta name="description" content="Read our latest research papers, medical articles, news, and blogs published by the Jarurat Care Foundation community." />
</svelte:head>

<Nav />

<div class="publications-page">
	<div class="hero-section">
		<div class="hero-content">
			<h1 in:fly={{ y: -20, duration: 800 }}>Community & Knowledge Hub</h1>
			<p in:fly={{ y: 20, duration: 800, delay: 200 }}>
				Explore our comprehensive collection of medical research papers, expert articles, health blogs, events, and latest news from our community of professionals.
			</p>
		</div>
	</div>

	<div class="container">
		<div class="controls-section">
			<div class="search-box">
				<svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<input type="text" placeholder="Search publications by title or content..." bind:value={searchQuery} />
			</div>

			<div class="filters">
				{#each filters as filter}
					<button 
						class="filter-btn" 
						class:active={activeFilter === filter}
						on:click={() => activeFilter = filter}
					>
						{filter}
					</button>
				{/each}
			</div>
		</div>

		<div class="publications-grid">
			{#each filteredPublications as pub, index (pub.id)}
				<div 
					class="pub-card" 
					on:click={() => openPublication(pub)}
					on:keydown={(e) => e.key === 'Enter' && openPublication(pub)}
					tabindex="0"
					in:fade={{ duration: 300, delay: Math.min(index * 50, 500) }}
				>
					<div class="pub-image">
						<img src={pub.thumbnail} alt={pub.title} loading="lazy" />
						<div class={`pub-badge ${getBadgeColor(pub.type)}`}>
							{pub.category}
						</div>
					</div>
					<div class="pub-content">
						<div class="pub-meta">
							<span class="pub-date">
								<svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dzq1"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
								{pub.date}
							</span>
							<span class="pub-author">
								<svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dzq1"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
								{pub.author}
							</span>
						</div>
						<h3 class="pub-title">{pub.title}</h3>
						<p class="pub-excerpt">{pub.excerpt}</p>
						<div class="pub-footer">
							<span class="pub-read-more">Read Full Article &rarr;</span>
							<div class="pub-actions">
								<button class="action-icon" class:liked={localLikes[pub.id]} on:click={(e) => toggleLike(e, pub)} aria-label="Like">
									<svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill={localLikes[pub.id] ? "currentColor" : "none"} stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
								</button>
								<button class="action-icon" on:click={(e) => shareArticle(e, pub)} aria-label="Share">
									<svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
								</button>
							</div>
						</div>
					</div>
				</div>
			{:else}
				<div class="empty-state">
					<svg viewBox="0 0 24 24" width="48" height="48" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dzq1"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
					<h3>No content found</h3>
					<p>We couldn't find any content matching your current search or filter criteria.</p>
					<button on:click={() => { searchQuery = ''; activeFilter = 'All'; }} class="clear-btn">Clear Filters</button>
				</div>
			{/each}
		</div>
	</div>
</div>

<NewsFooter />

<style>
